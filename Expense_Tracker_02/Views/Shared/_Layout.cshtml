<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ExpenseMate</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">ExpenseMate</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                <a class="nav-link" asp-controller="Transactions" asp-action="Index">Transactions</a>
                <a class="nav-link" asp-controller="Budgets" asp-action="Index">Budgets</a>
                <a class="nav-link" asp-controller="Reports" asp-action="Index">Reports</a>
            </div>
        </div>
    </nav>
    <div class="container">
        @if (TempData["Alert"] != null)
        {
            <div class="alert alert-warning">@TempData["Alert"]</div>
        }
        @RenderBody()
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>